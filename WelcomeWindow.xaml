<Window x:Class="CholinanzasApp.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenido a Cholinanzas" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PageBg}" FontFamily="Segoe UI" FontSize="14"
        TextElement.Foreground="{DynamicResource TextMain}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <StackPanel Margin="32,28,32,24">

        <TextBlock x:Name="StepText" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,8"
                   AutomationProperties.LiveSetting="Polite"/>

        <!-- Las tres páginas comparten el mismo lugar: la ventana toma la altura de la más alta y no "salta" al cambiar -->
        <Grid>
            <StackPanel x:Name="Page1">
                <TextBlock x:Name="Title1" FontSize="22" FontWeight="SemiBold" Text="Bienvenido a Cholinanzas"
                           Margin="0,0,0,14" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Style="{StaticResource HelpBody}"
                           Text="Cholinanzas te ayuda a ordenar tu plata: ver cuánto tenés hoy, cuánto vas a tener a fin de mes, en qué lo gastás y cuánto te conviene ahorrar."/>
                <TextBlock Style="{StaticResource HelpBody}"
                           Text="Funciona en pesos y en dólares, y te muestra todo junto cuando cargás la cotización."/>
                <TextBlock Style="{StaticResource HelpBody}" Margin="0"
                           Text="Tus datos se guardan solo en esta computadora. No hay que crear una cuenta ni registrarse, y la app no manda tu información a ningún lado."/>
            </StackPanel>

            <StackPanel x:Name="Page2" Visibility="Collapsed">
                <TextBlock x:Name="Title2" FontSize="22" FontWeight="SemiBold" Text="Así está organizada"
                           Margin="0,0,0,14" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Style="{StaticResource HelpBody}" Margin="0,0,0,8">
                    <Run FontWeight="SemiBold" Text="General: "/><Run Text="toda tu plata y tu historia completa."/>
                </TextBlock>
                <TextBlock Style="{StaticResource HelpBody}" Margin="0,0,0,8">
                    <Run FontWeight="SemiBold" Text="Este mes: "/><Run Text="lo que entró, lo que gastaste y cuánta plata vas a tener a fin de mes."/>
                </TextBlock>
                <TextBlock Style="{StaticResource HelpBody}" Margin="0,0,0,8">
                    <Run FontWeight="SemiBold" Text="Movimientos: "/><Run Text="donde anotás cada ingreso y cada gasto (o los importás desde un CSV o un Excel)."/>
                </TextBlock>
                <TextBlock Style="{StaticResource HelpBody}" Margin="0,0,0,8">
                    <Run FontWeight="SemiBold" Text="Recurrentes, Presupuestos y Metas: "/><Run Text="lo que se repite cada mes, tus límites de gasto y lo que querés juntar."/>
                </TextBlock>
                <TextBlock Style="{StaticResource HelpBody}" Margin="0,0,0,8">
                    <Run FontWeight="SemiBold" Text="Cuentas: "/><Run Text="tus cuentas, el dólar, los respaldos y la exportación a Excel."/>
                </TextBlock>
                <TextBlock Style="{StaticResource HelpBody}" Margin="0">
                    <Run FontWeight="SemiBold" Text="Ayuda: "/><Run Text="la explicación completa, cuando la necesites."/>
                </TextBlock>
            </StackPanel>

            <StackPanel x:Name="Page3" Visibility="Collapsed">
                <TextBlock x:Name="Title3" FontSize="22" FontWeight="SemiBold" Text="Para empezar"
                           Margin="0,0,0,14" AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Style="{StaticResource HelpBody}">
                    <Run FontWeight="SemiBold" Text="1. Creá tus cuentas. "/><Run Text="Una por cada lugar donde tenés plata, con lo que tenés hoy en cada una."/>
                </TextBlock>
                <TextBlock Style="{StaticResource HelpBody}">
                    <Run FontWeight="SemiBold" Text="2. Anotá tus movimientos. "/><Run Text="Empezá por los de este mes."/>
                </TextBlock>
                <TextBlock Style="{StaticResource HelpBody}">
                    <Run FontWeight="SemiBold" Text="3. Mirá General y Este mes. "/><Run Text="Ahí aparece la película completa."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <Button Content="Ir a Cuentas" Style="{StaticResource PrimaryButton}" Padding="16,7" Click="GoToAccounts_Click"/>
                    <Button Content="Ir a Movimientos" Style="{StaticResource ConfirmButton}" Padding="16,7" Margin="10,0,0,0"
                            Click="GoToTransactions_Click"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" FontSize="13"
                           Text="Podés volver a ver este recorrido cuando quieras desde la pestaña Ayuda."/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,22,0,0">
            <Button x:Name="SkipButton" Content="Saltar el recorrido" HorizontalAlignment="Left"
                    Style="{StaticResource ConfirmButton}" Padding="14,6" Click="Skip_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Anterior" Style="{StaticResource ConfirmButton}" Padding="16,6"
                        Click="Back_Click"/>
                <Button x:Name="NextButton" Content="Siguiente" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Padding="18,6" Margin="10,0,0,0" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
