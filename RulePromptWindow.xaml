<Window x:Class="CholinanzasApp.RulePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="¿Recordar esta categoría?" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PageBg}" FontFamily="Segoe UI" FontSize="13"
        TextElement.Foreground="{DynamicResource TextMain}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <StackPanel Margin="28,24,28,22">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="¿Querés que la app recuerde esto?" Margin="0,0,0,10"/>

        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>

        <!-- aviso cuando ya hay una regla que lo manda a otra categoría -->
        <TextBlock x:Name="NoteText" Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Margin="0,16,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Si la descripción contiene"/>
            <TextBox x:Name="PatternBox" MaxLength="60" AutomationProperties.Name="Texto que tiene que contener la descripción"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Text="Se busca dentro de la descripción, sin importar mayúsculas ni acentos. Dejá solo la parte que identifica al comercio, sin números."/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Negative}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Ahora no" IsCancel="True" Style="{StaticResource ConfirmButton}" Padding="16,6"/>
            <Button Content="Crear regla" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                    Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
