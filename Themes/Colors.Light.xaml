<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta del tema CLARO. Los estilos usan {DynamicResource}, así que al reemplazar este diccionario por
        Colors.Dark.xaml toda la app cambia de colores sin reiniciar. Cada archivo tiene que definir las mismas claves.
        Los colores de TEXTO cumplen contraste >= 4,5:1 (WCAG AA) sobre CardBg y sobre PageBg.
    -->

    <!-- Superficies -->
    <SolidColorBrush x:Key="PageBg" Color="#F4F6FB"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E1E6F0"/>
    <SolidColorBrush x:Key="Line" Color="#E8EBF2"/>

    <!-- Menú lateral (oscuro en los dos temas) -->
    <SolidColorBrush x:Key="SidebarBg" Color="#1B2540"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#27355A"/>
    <SolidColorBrush x:Key="SidebarText" Color="#C9D1E4"/>
    <SolidColorBrush x:Key="SidebarSubtext" Color="#8E9BBA"/>

    <!-- Acento: Accent es para rellenos (botones, pestaña activa) con texto blanco; AccentText para texto y barras -->
    <SolidColorBrush x:Key="Accent" Color="#3A52C8"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2F44A8"/>
    <SolidColorBrush x:Key="AccentText" Color="#3A52C8"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EEF1FE"/>
    <SolidColorBrush x:Key="AccentSoftHover" Color="#DDE3FC"/>

    <!-- Colores con significado -->
    <SolidColorBrush x:Key="Positive" Color="#167A4D"/>
    <SolidColorBrush x:Key="Negative" Color="#C0392B"/>
    <SolidColorBrush x:Key="Warning" Color="#B45309"/>

    <!-- Fondos suaves: botón de borrar al pasar el mouse y avisos de presupuesto -->
    <SolidColorBrush x:Key="DangerSoft" Color="#FDECEC"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#EDB5AE"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FEF3E2"/>
    <SolidColorBrush x:Key="WarnBorder" Color="#EBC995"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextMain" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextMuted" Color="#5B6472"/>
</ResourceDictionary>
