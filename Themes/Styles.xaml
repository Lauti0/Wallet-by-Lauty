<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta -->
    <SolidColorBrush x:Key="PageBg" Color="#F4F6FB"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#1B2540"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#27355A"/>
    <SolidColorBrush x:Key="SidebarText" Color="#C9D1E4"/>
    <!-- Colores de texto con contraste >= 4,5:1 (WCAG AA) sobre tarjeta blanca y sobre el fondo de página -->
    <SolidColorBrush x:Key="Accent" Color="#3A52C8"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2F44A8"/>
    <SolidColorBrush x:Key="Positive" Color="#167A4D"/>
    <SolidColorBrush x:Key="Negative" Color="#C0392B"/>
    <SolidColorBrush x:Key="Warning" Color="#B45309"/>
    <SolidColorBrush x:Key="TextMain" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextMuted" Color="#5B6472"/>
    <SolidColorBrush x:Key="Line" Color="#E8EBF2"/>

    <!-- Tarjeta -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBg}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,16,16"/>
        <!-- Sin DropShadowEffect: un Effect rasteriza todo el contenido de la tarjeta y deja el texto borroso -->
        <Setter Property="BorderBrush" Value="#E1E6F0"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Texto -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="Margin" Value="0,6,0,10"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    </Style>
    <Style x:Key="MidNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
    </Style>

    <!-- Mensaje de lista vacía: se muestra cuando el Tag (cantidad de filas) es 0 -->
    <Style x:Key="EmptyState" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,18,0,8"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Botones -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="8"
                            BorderThickness="2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <!-- anillo visible al navegar con el teclado -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextMain}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón chico de acción en tablas (✕, Registrar...) -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FDECEC"/>
                            <Setter Property="Foreground" Value="{StaticResource Negative}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextMain}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ConfirmButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#EEF1FE" CornerRadius="6"
                            BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DDE3FC"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextMain}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flechas del selector de mes -->
    <Style x:Key="MonthArrow" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource CardBg}" CornerRadius="17"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EEF1FE"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextMain}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tablas -->
    <Style x:Key="TableHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style x:Key="TableGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="RowHeight" Value="38"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource TableHeader}"/>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style x:Key="CellRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Menú lateral -->
    <Style x:Key="SideTabItem" TargetType="TabItem">
        <!-- el lector de pantalla lee el título de la página en vez del emoji del encabezado -->
        <Setter Property="AutomationProperties.Name" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Margin="12,2"
                            BorderThickness="2" BorderBrush="Transparent"
                            Padding="14,9" Cursor="Hand">
                        <ContentPresenter x:Name="Cp" ContentSource="Header"
                                          TextElement.Foreground="{StaticResource SidebarText}"
                                          TextElement.FontSize="14"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="White"/>
                            <Setter TargetName="Cp" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Contenedor: menú a la izquierda, título + selector de mes arriba, página a la derecha -->
    <Style x:Key="SideTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource PageBg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>

        <!-- Encabezado de cada página: título, selector de mes y alertas de presupuesto, y debajo la página.
             Va en la plantilla del CONTENIDO y no en la del TabControl porque WPF solo muestra a los lectores
             de pantalla las pestañas y el contenido de la pestaña elegida, no el resto de la plantilla.
             Dentro de esta plantilla el DataContext es la página, por eso se llega al ViewModel por la ventana. -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="32,24,32,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- el selector de mes no aplica a las vistas que muestran todo -->
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.Tag, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                         Value="Panorama general">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedItem.Tag, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                         Value="Cuentas y datos">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="◀" Style="{StaticResource MonthArrow}" ToolTip="Mes anterior"
                                        AutomationProperties.Name="Mes anterior"
                                        Command="{Binding DataContext.PreviousMonthCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Text="{Binding DataContext.MonthTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="16" FontWeight="SemiBold" Width="150" TextAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMain}"/>
                                <Button Content="▶" Style="{StaticResource MonthArrow}" ToolTip="Mes siguiente"
                                        AutomationProperties.Name="Mes siguiente"
                                        Command="{Binding DataContext.NextMonthCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}"
                                       Text="{Binding SelectedItem.Tag, RelativeSource={RelativeSource AncestorType=TabControl}}"/>
                        </DockPanel>

                        <!-- Alertas de presupuesto: visibles en todas las pestañas; el lector de pantalla las anuncia al cambiar -->
                        <ItemsControl Grid.Row="1" Margin="32,0,32,6" Focusable="False"
                                      AutomationProperties.Name="Alertas de presupuesto"
                                      AutomationProperties.LiveSetting="Polite"
                                      ItemsSource="{Binding DataContext.BudgetAlerts, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="14,8" Margin="0,0,0,6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3E2"/>
                                                <Setter Property="BorderBrush" Value="#EBC995"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExceeded}" Value="True">
                                                        <Setter Property="Background" Value="#FDECEC"/>
                                                        <Setter Property="BorderBrush" Value="#EDB5AE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Warning}"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMain}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- la página en sí (el contenido de la pestaña) -->
                        <ContentPresenter Grid.Row="2" Content="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{StaticResource PageBg}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource SidebarBg}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="26,28,22,24">
                                    <TextBlock Text="💰" FontSize="30"/>
                                    <TextBlock Text="Cholinanzas" Foreground="White" FontSize="21"
                                               FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock Text="Tus finanzas, claras" Foreground="#8E9BBA" FontSize="12"/>
                                </StackPanel>
                                <StackPanel IsItemsHost="True" Margin="0,0,0,12"/>
                            </DockPanel>
                        </Border>

                        <!-- El nombre PART_SelectedContentHost es obligatorio: sin él, los lectores de pantalla no ven el contenido de la pestaña -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
