<Window x:Class="CholinanzasApp.LegalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PageBg}" FontFamily="Segoe UI" FontSize="14"
        TextElement.Foreground="{DynamicResource TextMain}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock x:Name="IntroText" Grid.Row="1" Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,12"
                   Visibility="Collapsed"/>

        <!-- el texto completo, de solo lectura pero con foco, para poder recorrerlo con el teclado y con un lector de pantalla -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" CornerRadius="10">
            <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource TextMain}" Padding="16,12" FontSize="13"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeclineButton" Content="No acepto" Style="{StaticResource ConfirmButton}" Padding="18,7"
                    Click="Decline_Click"/>
            <Button x:Name="AcceptButton" Content="Acepto" Style="{StaticResource PrimaryButton}" Padding="22,7"
                    Margin="10,0,0,0" Click="Accept_Click"/>
            <Button x:Name="CloseButton" Content="Cerrar" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}"
                    Padding="22,7" Visibility="Collapsed" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
