                        <TextBlock Style="{StaticResource EditableTitle}" Tag="{Binding IsEditingBudget}"
                                   Text="{Binding BudgetFormTitle}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Categoría"/>
                                <ComboBox Width="190" ItemsSource="{Binding ExpenseCategories}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding NewBudgetCategory}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Moneda"/>
                                <ComboBox Width="90" ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewBudgetCurrency}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Límite por mes"/>
                                <TextBox Width="150" Text="{Binding NewBudgetAmount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Content="{Binding SaveBudgetText}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                    Margin="0,0,0,12" Command="{Binding AddBudgetCommand}"/>
                            <Button Content="Cancelar" Tag="{Binding IsEditingBudget}" Style="{StaticResource CancelEditButton}"
                                    Command="{Binding CancelBudgetEditCommand}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Hay un solo presupuesto por categoría y moneda. Si agregás uno que ya existe, se actualiza su límite."/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <DataGrid Style="{StaticResource TableGrid}" ItemsSource="{Binding Budgets}"
                                  AutomationProperties.Name="Presupuestos del mes">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="*" MinWidth="110"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Límite" Binding="{Binding LimitText}" Width="115"
                                                    ElementStyle="{StaticResource CellRight}"/>
                                <DataGridTextColumn Header="Gastado" Binding="{Binding SpentText}" Width="115"
                                                    ElementStyle="{StaticResource CellRight}"/>
                                <DataGridTextColumn Header="Queda" Binding="{Binding RemainingText}" Width="115"
                                                    ElementStyle="{StaticResource CellRight}"/>
                                <DataGridTemplateColumn Header="Uso" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Minimum="0" Maximum="100" Height="8" Margin="10,0"
                                                         AutomationProperties.Name="Uso del presupuesto"
                                                         Value="{Binding Percent, Mode=OneWay}" Background="{DynamicResource Line}"
                                                         BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Foreground" Value="{DynamicResource Positive}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cerca del límite">
                                                                <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Excedido">
                                                                <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="%" Binding="{Binding PercentText}" Width="55"
                                                    ElementStyle="{StaticResource CellRight}"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="125"
                                                    ElementStyle="{StaticResource BudgetStatus}"/>
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Editar" ToolTip="Modificar este presupuesto"
                                                    AutomationProperties.Name="Editar" Style="{StaticResource ConfirmButton}"
                                                    Command="{Binding DataContext.EditBudgetCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="45">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" ToolTip="Eliminar" AutomationProperties.Name="Eliminar" Style="{StaticResource RowButton}"
                                                    Command="{Binding DataContext.DeleteBudgetCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding Budgets.Count}"
                                   VerticalAlignment="Center"
                                   Text="Todavía no definiste presupuestos. Elegí una categoría y poné cuánto querés gastar como máximo por mes."/>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ═══════════════ METAS ═══════════════ -->
        <TabItem Header="🏆  Metas" Tag="Metas de ahorro">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,16,24">

                    <TextBlock Style="{StaticResource SectionTitle}" Text="¿Cuánto debería ahorrar?" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding GoalPlan}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" MinWidth="500">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Currency}" FontWeight="SemiBold"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Necesitás ahorrar por mes"/>
                                                <TextBlock Style="{StaticResource MidNumber}" Text="{Binding MonthlyNeededText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ahorraste en el mes visible"/>
                                                <TextBlock Style="{StaticResource MidNumber}" Text="{Binding MonthNetText}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource PlanStatus}" Margin="0,10,0,0" Text="{Binding Status}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding GoalPlan.Count}"
                               Margin="0,0,0,16" TextAlignment="Left"
                               Text="Cuando crees una meta vas a ver acá cuánto tenés que ahorrar por mes."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditableTitle}" Tag="{Binding IsEditingGoal}"
                                       Text="{Binding GoalFormTitle}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre"/>
                                    <TextBox Width="180" MaxLength="80" Text="{Binding NewGoalName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Ej: Vacaciones, Auto, Fondo de emergencia"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Moneda"/>
                                    <ComboBox Width="90" ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewGoalCurrency}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Objetivo"/>
                                    <TextBox Width="140" Text="{Binding NewGoalTarget, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ya ahorrado"/>
                                    <TextBox Width="130" Text="{Binding NewGoalSaved, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fecha objetivo"/>
                                    <DatePicker Width="140" SelectedDate="{Binding NewGoalDate}"/>
                                </StackPanel>
                                <Button Content="{Binding SaveGoalText}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                        Margin="0,0,0,12" Command="{Binding AddGoalCommand}"/>
                                <Button Content="Cancelar" Tag="{Binding IsEditingGoal}" Style="{StaticResource CancelEditButton}"
                                        Command="{Binding CancelGoalEditCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Mis metas" Margin="0,0,0,8"/>
                            <DataGrid Style="{StaticResource TableGrid}" ItemsSource="{Binding Goals}" AutomationProperties.Name="Metas de ahorro"
                                      SelectedItem="{Binding SelectedGoal}" SelectionMode="Single" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Meta" Binding="{Binding Name}" Width="*" MinWidth="110"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Objetivo" Binding="{Binding TargetText}" Width="125"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTextColumn Header="Ahorrado" Binding="{Binding SavedText}" Width="125"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTemplateColumn Header="Avance" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Minimum="0" Maximum="100" Height="8" Margin="10,0"
                                                             AutomationProperties.Name="Avance de la meta"
                                                             Foreground="{DynamicResource Positive}" Background="{DynamicResource Line}"
                                                             BorderThickness="0" Value="{Binding Percent, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="%" Binding="{Binding PercentText}" Width="55"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTextColumn Header="Plazo" Binding="{Binding Status}" Width="85"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Por mes" Binding="{Binding MonthlyNeededText}" Width="125"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTemplateColumn Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Editar" ToolTip="Modificar esta meta"
                                                        AutomationProperties.Name="Editar" Style="{StaticResource ConfirmButton}"
                                                        Command="{Binding DataContext.EditGoalCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="45">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" ToolTip="Eliminar" AutomationProperties.Name="Eliminar" Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.DeleteGoalCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding Goals.Count}"
                                       Text="Todavía no tenés metas. Creá la primera con el formulario de arriba."/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Aportar a la meta seleccionada:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Width="140" AutomationProperties.Name="Monto del aporte"
                                         Text="{Binding ContributionAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Aportar" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                        Command="{Binding ContributeCommand}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Seleccioná una meta de la tabla. Un monto negativo resta (para corregir o retirar)."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ CUENTAS ═══════════════ -->
        <TabItem Header="🏦  Cuentas" Tag="Cuentas y datos">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,16,24">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditableTitle}" Tag="{Binding IsEditingAccount}"
                                       Text="{Binding AccountFormTitle}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre"/>
                                    <TextBox Width="220" MaxLength="60" Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Ej: Banco Galicia, Mercado Pago, Dólares en casa"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Moneda"/>
                                    <ComboBox Width="90" ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewAccountCurrency}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Saldo inicial"/>
                                    <TextBox Width="150" Text="{Binding NewAccountInitial, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <Button Content="{Binding SaveAccountText}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                        Margin="0,0,0,12" Command="{Binding AddAccountCommand}"/>
                                <Button Content="Cancelar" Tag="{Binding IsEditingAccount}" Style="{StaticResource CancelEditButton}"
                                        Command="{Binding CancelAccountEditCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="El saldo inicial es lo que tenés hoy en esa cuenta; a partir de ahí se suman tus movimientos."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Mis cuentas" Margin="0,0,0,8"/>
                            <DataGrid Style="{StaticResource TableGrid}" ItemsSource="{Binding Accounts}" MaxHeight="300"
                                      AutomationProperties.Name="Cuentas y saldos">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cuenta" Binding="{Binding Name}" Width="*"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="100"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Saldo actual" Binding="{Binding BalanceText}" Width="180"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTemplateColumn Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Editar" ToolTip="Cambiar el nombre o el saldo inicial"
                                                        AutomationProperties.Name="Editar" Style="{StaticResource ConfirmButton}"
                                                        Command="{Binding DataContext.EditAccountCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="45">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" ToolTip="Eliminar esta cuenta" AutomationProperties.Name="Eliminar cuenta"
                                                        Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.DeleteAccountCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Cotización del dólar" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pesos por 1 USD"/>
                                    <TextBox Width="160" Text="{Binding NewRate, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <Button Content="Guardar" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                                        Margin="0,0,0,12" Command="{Binding SaveRateCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RateInfo}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Se usa la última cargada para calcular tu patrimonio total y para sugerir conversiones en las transferencias."/>

                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Traer la cotización de internet (opcional)"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <StackPanel Style="{StaticResource Field}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Dólar"/>
                                            <ComboBox Width="200" ItemsSource="{Binding RateSources}" DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedRateSource}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Field}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Valor"/>
                                            <ComboBox Width="120" ItemsSource="{Binding RatePrices}" DisplayMemberPath="Label"
                                                      SelectedItem="{Binding SelectedRatePrice}"/>
                                        </StackPanel>
                                        <Button Content="Actualizar ahora" Style="{StaticResource ConfirmButton}" VerticalAlignment="Bottom"
                                                Margin="0,0,0,12" Command="{Binding UpdateRateNowCommand}"
                                                IsEnabled="{Binding CanUpdateRate}"/>
                                    </StackPanel>
                                    <CheckBox Content="Actualizar sola, una vez por día, al abrir la app"
                                              IsChecked="{Binding AutoRateEnabled}"/>
                                    <TextBlock Text="{Binding RateStatus}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Esto es lo único que usa internet: pide la cotización pública a dolarapi.com, sin enviar ninguno de tus datos. Si falla o no tenés conexión, la app sigue con la última cotización cargada."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Exportar tus datos" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                       Text="Te llevás toda tu información para guardarla, analizarla o compartirla. Elegís dónde guardar el archivo."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Exportar todo a Excel" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ExportExcelCommand}"
                                        ToolTip="Un archivo .xlsx con una hoja por tema: movimientos, transferencias, cuentas, mes a mes, categorías, presupuestos, metas, recurrentes y cuotas"/>
                                <Button Content="Movimientos a CSV" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                                        Command="{Binding ExportCsvCommand}"
                                        ToolTip="Solo los movimientos, en un archivo de texto que abre Excel"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Text="El Excel incluye una hoja por tema (movimientos, transferencias, cuentas, mes a mes, categorías, presupuestos, metas, recurrentes y cuotas). En los movimientos, los gastos van en negativo para que puedas sumar directo."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Respaldos" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                       Text="Una vez por día, al abrir la app, se guarda una copia automática de todos tus datos. Si algo sale mal, podés volver a cualquiera de ellas."/>

                            <TextBlock FontWeight="SemiBold" Text="{Binding BackupStatus}"/>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Negative}"
                                       Text="{Binding BackupError}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Respaldar ahora" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding BackupNowCommand}"/>
                                <Button Content="Abrir carpeta de respaldos" Style="{StaticResource ConfirmButton}"
                                        Padding="16,8" Margin="12,0,0,0" Command="{Binding OpenBackupFolderCommand}"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,18"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Copia extra (recomendado)"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{Binding ExtraFolderText}"/>
                                <Button Content="Elegir carpeta…" Style="{StaticResource ConfirmButton}" Padding="16,8"
                                        Margin="14,0,0,0" Command="{Binding ChooseExtraFolderCommand}"/>
                                <Button Content="Quitar" Margin="6,0,0,0" Command="{Binding ClearExtraFolderCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasExtraFolder}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Un respaldo en esta misma PC no te protege si falla el disco. Elegí una carpeta de OneDrive, Google Drive o un pendrive y cada respaldo se copia también ahí."/>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Respaldos guardados" Margin="0,20,0,8"/>
                            <DataGrid Style="{StaticResource TableGrid}" ItemsSource="{Binding Backups}" MaxHeight="280"
                                      AutomationProperties.Name="Respaldos guardados">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha y hora" Binding="{Binding DateText}" Width="*"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeText}" Width="110"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTemplateColumn Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Restaurar" Style="{StaticResource ConfirmButton}"
                                                        ToolTip="Volver a los datos de este respaldo"
                                                        Command="{Binding DataContext.RestoreBackupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding Backups.Count}"
                                       Text="Todavía no hay respaldos. Apretá &quot;Respaldar ahora&quot; para hacer el primero."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Apariencia" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Elegí cómo se ve la app. El cambio es inmediato y queda guardado."/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="theme" Margin="0,0,28,0" Content="☀  Claro"
                                             AutomationProperties.Name="Tema claro" IsChecked="{Binding ThemeLight}"/>
                                <RadioButton GroupName="theme" Margin="0,0,28,0" Content="🌙  Oscuro"
                                             AutomationProperties.Name="Tema oscuro" IsChecked="{Binding ThemeDark}"/>
                                <RadioButton GroupName="theme" Content="💻  Según Windows"
                                             AutomationProperties.Name="Tema según Windows" IsChecked="{Binding ThemeSystem}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="«Según Windows» usa el tema claro u oscuro que tengas en Windows y cambia solo cuando lo cambies allá."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Privacidad de tus datos" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,6"
                                       Text="• Tus datos se guardan solo en esta computadora, en tu carpeta de usuario de Windows (%LOCALAPPDATA%\CholinanzasApp)."/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,6"
                                       Text="• La app no tiene cuentas de usuario y no envía tus datos a nadie. Solo se conecta a internet si vos lo pedís, para traer la cotización pública del dólar (dolarapi.com): esa consulta no lleva ninguno de tus datos, aunque el servicio puede ver tu dirección IP como cualquier página web."/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,6"
                                       Text="• Tus datos solo salen de acá si vos lo decidís: al exportar un archivo o al elegir una carpeta extra para los respaldos (por ejemplo, una carpeta de OneDrive)."/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="13"
                                       Text="• Los datos no están cifrados. Si compartís esta computadora, protegé tu usuario de Windows con contraseña."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ───────────── Ayuda ───────────── -->
        <TabItem Header="❓  Ayuda" Tag="Ayuda">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,16,24" MaxWidth="860" HorizontalAlignment="Left">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Primeros pasos" Margin="0,0,0,10"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="1. Creá tus cuentas. "/>
                                <Run Text="En la pestaña Cuentas, agregá una por cada lugar donde tenés plata: efectivo, un banco, una billetera virtual, dólares. En «Saldo inicial» poné lo que tenés hoy en cada una."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="2. Cargá la cotización del dólar "/>
                                <Run Text="si tenés cuentas en dólares. En Cuentas, tarjeta «Cotización del dólar»: la escribís vos o la traés de internet. Sirve para ver tu plata total en pesos y en dólares."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="3. Cargá tus movimientos. "/>
                                <Run Text="En Movimientos anotá cada ingreso y cada gasto. Si tu banco te deja bajar el extracto en CSV o en Excel (.xlsx), usá «Importar desde CSV o Excel…» en esa misma pestaña y te ahorrás tipear."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="4. Anotá lo que se repite todos los meses "/>
                                <Run Text="(alquiler, sueldo, suscripciones) en Recurrentes. Con eso la app calcula cuánta plata vas a tener a fin de mes."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="5. Poné límites y metas. "/>
                                <Run Text="En Presupuestos definís cuánto querés gastar como máximo por categoría; en Metas, cuánto querés juntar y para cuándo."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}" Margin="0">
                                <Run FontWeight="SemiBold" Text="6. Cuidá tus datos. "/>
                                <Run Text="La app hace un respaldo por día sola. Además, en Cuentas podés elegir una carpeta extra (por ejemplo de OneDrive) para que cada respaldo se copie también ahí."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="¿Dónde veo…?" Margin="0,0,0,10"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="…cuánta plata tengo hoy y cuánta voy a tener. "/>
                                <Run Text="En General: «Tu plata hoy» y lo proyectado a fin de mes. En «Este mes», sección «Hacia fin de mes», lo ves por moneda."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="…cuánto puedo gastar por día. "/>
                                <Run Text="En «Este mes»: «Podés gastar por día» es lo que vas a tener a fin de mes dividido los días que quedan (contando hoy). Solo existe para el mes en curso."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="…en qué gasto la plata. "/>
                                <Run Text="«Este mes» muestra tus gastos por categoría; en General, los gráficos muestran las categorías con más gasto de los últimos 6 meses."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="…cuánto tendría que ahorrar. "/>
                                <Run Text="En Metas, «Necesitás ahorrar por mes» te dice cuánto separar para llegar a tus metas en la fecha elegida. «Te quedó» y «Ahorro» (en «Este mes» y en General) muestran cuánto ahorraste de verdad."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}" Margin="0">
                                <Run FontWeight="SemiBold" Text="…otros meses. "/>
                                <Run Text="Con el selector de mes de arriba cambiás de mes en las pestañas que dependen del mes. General siempre muestra toda tu historia."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Cosas que conviene saber" Margin="0,0,0,10"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Los recurrentes no se cargan solos. "/>
                                <Run Text="Cuando el alquiler o el sueldo se concreten, entrá a Recurrentes y apretá «Registrar»: ahí se crea el movimiento real. Hasta entonces aparecen como «pendientes» en la proyección."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Las cuotas de la tarjeta se registran solas. "/>
                                <Run Text="Cargá la compra en la pestaña Cuotas: cada cuota se anota como gasto cuando llega su fecha, y las que faltan cuentan en la proyección. Si cargás una compra vieja, poné en «Ya pagadas» las que ya pagaste para que no se anoten de nuevo."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Una transferencia no es un gasto ni un ingreso. "/>
                                <Run Text="Pasar plata de una cuenta a otra (por ejemplo, del banco al efectivo, o de pesos a dólares) no cambia lo que gastaste ni lo que ganaste."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Las categorías se sugieren solas. "/>
                                <Run Text="Al escribir la descripción de un movimiento, la app propone una categoría según tus reglas. Si la corregís, te ofrece crear una regla para que la próxima vez acierte. Todas están en la pestaña Reglas."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Pesos y dólares van separados. "/>
                                <Run Text="No se mezclan en las cuentas ni en los resúmenes; solo se convierten para mostrar tu plata total, usando la última cotización cargada."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Alertas de presupuesto. "/>
                                <Run Text="Si te acercás al límite de una categoría o lo superás, aparece un aviso arriba de todas las pestañas."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}" Margin="0">
                                <Run FontWeight="SemiBold" Text="Borrar es para siempre (casi). "/>
                                <Run Text="Eliminar una cuenta borra también sus movimientos, y antes la app guarda un respaldo que podés restaurar. Eliminar un movimiento, una regla o una meta no genera respaldo."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Si algo sale mal" Margin="0,0,0,10"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Volver atrás. "/>
                                <Run Text="En Cuentas, sección «Respaldos guardados», elegí un respaldo y apretá «Restaurar». Antes de restaurar, la app guarda una copia de lo que tenías."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Si aparece un error inesperado, "/>
                                <Run Text="la app sigue funcionando y deja los detalles en el archivo errores.log, en la carpeta de tus datos."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource HelpBody}">
                                <Run FontWeight="SemiBold" Text="Llevarte tus datos. "/>
                                <Run Text="En Cuentas, «Exportar todo a Excel» o «Movimientos a CSV»."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,2" Text="Tus datos están en esta carpeta:"/>
                            <TextBox Text="{Binding DataFolderText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0"
                                     Background="Transparent" Foreground="{DynamicResource TextMain}" FontSize="13"
                                     AutomationProperties.Name="Carpeta donde se guardan tus datos"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Ver el recorrido de bienvenida" Style="{StaticResource ConfirmButton}"
                                        Margin="0,0,10,8" Command="{Binding ShowWelcomeCommand}"/>
                                <Button Content="Términos y privacidad" Style="{StaticResource ConfirmButton}"
                                        Margin="0,0,10,8" Command="{Binding ShowLegalCommand}" CommandParameter="terms"/>
                                <Button Content="Avisos de terceros" Style="{StaticResource ConfirmButton}"
                                        Margin="0,0,0,8" Command="{Binding ShowLegalCommand}" CommandParameter="notices"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{Binding AppVersionText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
