<Window x:Class="CholinanzasApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cholinanzas" Height="780" Width="1280" MinWidth="1180" MinHeight="620"
        Background="{DynamicResource PageBg}" FontFamily="Segoe UI" FontSize="13"
        TextElement.Foreground="{DynamicResource TextMain}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <!-- Monto verde si es ingreso, rojo si es gasto -->
        <Style x:Key="AmountByType" TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
            <Setter Property="Foreground" Value="{DynamicResource Positive}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Gasto">
                    <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Números que se pintan de rojo cuando son negativos -->
        <Style x:Key="NegBalance" TargetType="TextBlock" BasedOn="{StaticResource MidNumber}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNegative}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NegNet" TargetType="TextBlock" BasedOn="{StaticResource MidNumber}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NetIsNegative}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NegProjected" TargetType="TextBlock" BasedOn="{StaticResource MidNumber}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProjectedIsNegative}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NegAvgNet" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvgNetIsNegative}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NegValueSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNegative}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NetCell" TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NetIsNegative}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlanStatus" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Positive}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShort}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BudgetStatus" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Positive}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Cerca del límite">
                    <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Excedido">
                    <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Título de un formulario que también sirve para editar: se pinta de azul mientras se edita (Tag = ¿se está editando?) -->
        <Style x:Key="EditableTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "Cancelar" de un formulario: solo se ve mientras se edita (Tag = ¿se está editando?) -->
        <Style x:Key="CancelEditButton" TargetType="Button" BasedOn="{StaticResource ConfirmButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="8,0,0,12"/>
            <Setter Property="ToolTip" Value="Descartar los cambios"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Campo de formulario: etiqueta arriba, control abajo -->
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,12"/>
        </Style>
    </Window.Resources>

    <TabControl Style="{StaticResource SideTabControl}" ItemContainerStyle="{StaticResource SideTabItem}">

        <!-- ═══════════════ GENERAL (no depende del mes) ═══════════════ -->
        <TabItem Header="🏠  General" Tag="Panorama general">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,16,24">

                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                               Text="Esta vista muestra toda tu plata y tu historia completa, sin importar el mes."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tu plata hoy"/>
                    <ItemsControl ItemsSource="{Binding NetWorth}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" MinWidth="280">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}"/>
                                        <TextBlock Style="{StaticResource BigNumber}" Text="{Binding ArsText}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                   Text="{Binding UsdText}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Mis cuentas"/>
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" MinWidth="220" Padding="18,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Currency, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource NegBalance}" Text="{Binding BalanceText}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Toda tu historia"/>
                    <ItemsControl ItemsSource="{Binding OverviewTotals}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" MinWidth="560">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Currency}" FontWeight="SemiBold"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Total que entró"/>
                                                <TextBlock Style="{StaticResource MidNumber}" Foreground="{DynamicResource Positive}"
                                                           Text="{Binding IncomeText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Total que gastaste"/>
                                                <TextBlock Style="{StaticResource MidNumber}" Foreground="{DynamicResource Negative}"
                                                           Text="{Binding ExpenseText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ahorrado en total"/>
                                                <TextBlock Style="{StaticResource NegNet}" Text="{Binding NetText}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,14"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding AvgTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Entra por mes"/>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding AvgIncomeText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Gastás por mes"/>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding AvgExpenseText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ahorrás por mes"/>
                                                <TextBlock Style="{StaticResource NegAvgNet}" Text="{Binding AvgNetText}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding OverviewTotals.Count}"
                               Margin="0,0,0,16" TextAlignment="Left"
                               Text="Cuando cargues movimientos vas a ver acá tus totales y promedios."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Gráficos"/>
                    <ItemsControl ItemsSource="{Binding OverviewBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="480">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold">
                                            <Run Text="Ingresos vs. gastos · "/><Run Text="{Binding Currency, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                    Background="{DynamicResource Positive}"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="6,0,16,0" Text="Ingresos"/>
                                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                    Background="{DynamicResource Negative}"/>
                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="6,0,0,0" Text="Gastos"/>
                                        </StackPanel>
                                        <!-- texto alternativo del gráfico para lectores de pantalla; los mismos números están en la tabla "Mes a mes" -->
                                        <ItemsControl ItemsSource="{Binding Months}" Margin="0,14,0,0"
                                                      AutomationProperties.Name="{Binding Summary}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Background="Transparent" ToolTip="{Binding Tooltip}">
                                                        <Grid Height="170">
                                                            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Line}"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                                        VerticalAlignment="Bottom">
                                                                <Border Width="18" Height="{Binding IncomeHeight}" Margin="0,0,4,0"
                                                                        VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                                        Background="{DynamicResource Positive}"/>
                                                                <Border Width="18" Height="{Binding ExpenseHeight}"
                                                                        VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                                        Background="{DynamicResource Negative}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0"
                                                                   HorizontalAlignment="Center" Text="{Binding Label}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding OverviewLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="480">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold">
                                            <Run Text="Tu plata a fin de cada mes · "/><Run Text="{Binding Currency, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Canvas Width="440" Height="150" Margin="0,14,0,0" HorizontalAlignment="Left">
                                            <Polyline Points="{Binding Line}" Stroke="{DynamicResource AccentText}"
                                                      StrokeThickness="3" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <ItemsControl ItemsSource="{Binding Dots}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse Width="10" Height="10" Margin="-5,-5,0,0"
                                                                 Fill="{DynamicResource CardBg}" Stroke="{DynamicResource AccentText}" StrokeThickness="2.5"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                        <ItemsControl ItemsSource="{Binding Months}" Width="440" HorizontalAlignment="Left"
                                                      AutomationProperties.Name="{Binding Summary}"
                                                      Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0"
                                                                   HorizontalAlignment="Center" Text="{Binding Label}"/>
                                                        <TextBlock Style="{StaticResource NegValueSmall}"
                                                                   HorizontalAlignment="Center" Text="{Binding ValueText}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding OverviewBars.Count}"
                               Margin="0,0,0,16" TextAlignment="Left"
                               Text="Cuando tengas movimientos, vas a ver acá los gráficos."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Mes a mes"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DataGrid Style="{StaticResource TableGrid}" ItemsSource="{Binding OverviewHistory}"
                                      AutomationProperties.Name="Ingresos y gastos mes a mes">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mes" Binding="{Binding MonthText}" Width="*" MinWidth="150"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Moneda" Binding="{Binding Currency}" Width="80"
                                                        ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Ingresos" Binding="{Binding IncomeText}" Width="140"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTextColumn Header="Gastos" Binding="{Binding ExpenseText}" Width="140"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTextColumn Header="Te quedó" Binding="{Binding NetText}" Width="140"
                                                        ElementStyle="{StaticResource NetCell}"/>
                                    <DataGridTextColumn Header="Ahorro" Binding="{Binding SavingsText}" Width="80"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding OverviewHistory.Count}"
                                       Text="Todavía no hay historia para mostrar."/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="'Ahorro' es el porcentaje de lo que entró que no gastaste. Se muestran hasta los últimos 6 meses."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="¿En qué gastás más?"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding OverviewCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Category, Mode=OneWay}"/>
                                                <Run Text=" · " Foreground="{DynamicResource TextMuted}"/>
                                                <Run Text="{Binding Currency, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
                                            </TextBlock>
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="8" Margin="8,0"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Foreground="{DynamicResource AccentText}" Background="{DynamicResource Line}"
                                                         AutomationProperties.Name="{Binding Category}"
                                                         BorderThickness="0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" TextAlignment="Right"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentText}" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding OverviewCategories.Count}"
                                       Text="Todavía no registraste gastos."/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Las 6 categorías con más gasto en los últimos 6 meses."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ ESTE MES ═══════════════ -->
        <TabItem Header="📊  Este mes" Tag="Resumen del mes">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,0,16,24">

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ingresos y gastos del mes"/>
                    <ItemsControl ItemsSource="{Binding Summary}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" MinWidth="500">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Currency}" FontWeight="SemiBold"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Ingresos"/>
                                                <TextBlock Style="{StaticResource MidNumber}" Foreground="{DynamicResource Positive}"
                                                           Text="{Binding IncomeText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Gastos"/>
                                                <TextBlock Style="{StaticResource MidNumber}" Foreground="{DynamicResource Negative}"
                                                           Text="{Binding ExpenseText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Te quedó"/>
                                                <TextBlock Style="{StaticResource NegNet}" Text="{Binding NetText}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding Summary.Count}"
                               Text="Todavía no hay movimientos este mes. Cargá el primero en la pestaña Movimientos."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Hacia fin de mes"/>
                    <ItemsControl ItemsSource="{Binding Projection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" MinWidth="500">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Currency}" FontWeight="SemiBold"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Tenés hoy"/>
                                                <TextBlock Style="{StaticResource MidNumber}" Text="{Binding BalanceText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Vas a tener"/>
                                                <TextBlock Style="{StaticResource NegProjected}" Text="{Binding ProjectedText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Podés gastar por día"/>
                                                <TextBlock Style="{StaticResource MidNumber}" Foreground="{DynamicResource AccentText}"
                                                           Text="{Binding DailyText}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0">
                                            <Run Text="Pendiente de registrar:  +"/><Run Text="{Binding PendingIncomeText, Mode=OneWay}"/>
                                            <Run Text="  /  −"/><Run Text="{Binding PendingExpenseText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,-6,0,0"
                               Text="Se calcula con tus movimientos recurrentes y cuotas que todavía no registraste. 'Por día' solo aplica al mes en curso."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="¿En qué gastaste?" Margin="0,20,0,10"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding CategoryTotals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding Category, Mode=OneWay}"/>
                                                <Run Text=" · " Foreground="{DynamicResource TextMuted}"/>
                                                <Run Text="{Binding Currency, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
                                            </TextBlock>
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="8" Margin="8,0"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Foreground="{DynamicResource AccentText}" Background="{DynamicResource Line}"
                                                         AutomationProperties.Name="{Binding Category}"
                                                         BorderThickness="0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" TextAlignment="Right"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentText}" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EmptyState}" Tag="{Binding CategoryTotals.Count}"
                                       Text="Todavía no registraste gastos este mes."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ═══════════════ MOVIMIENTOS ═══════════════ -->
        <TabItem Header="🧾  Movimientos" Tag="Movimientos">
            <Grid Margin="32,0,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Importar desde CSV o Excel…" Style="{StaticResource ConfirmButton}"
                                Padding="14,6" Command="{Binding ImportCsvCommand}"
                                ToolTip="Cargar muchos movimientos juntos desde el archivo que descargás del banco"
                                AutomationProperties.Name="Importar movimientos desde un archivo CSV o Excel"/>
                        <!-- "Nuevo movimiento" o "Editar movimiento" (en azul para que se note que se está editando) -->
                        <TextBlock Text="{Binding TransactionFormTitle}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </DockPanel>
                        <WrapPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Tipo"/>
                                <ComboBox Width="110" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding NewType}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Fecha"/>
                                <DatePicker Width="140" SelectedDate="{Binding NewDate}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Monto"/>
                                <TextBox Width="130" Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
